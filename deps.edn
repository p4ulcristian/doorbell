;; groundwork-live-updates: a change to a table rings every open screen, and the screens that
;; read that table ask again. One tree for both languages: source-code/groundwork_live_updates/,
;; the server's .clj and the browser's .cljs side by side.
{:paths ["source-code"]

 :deps
 {;; Postgres: the trigger's function, the table maps' :on-change, listening,
  ;; the tables a handler's queries read
  ;; on its tidy-up branch, not released: a table map writes out :uniques and :checks,
  ;; a reference what it does on delete, update and when checked, an index as a map;
  ;; migrate! takes {:tables :extensions :functions :views}; run-in-transaction! takes the
  ;; caller's :log
  io.github.p4ulcristian/groundwork-postgres   {:git/tag "v0.4.7" :git/sha "d6f226c"}
  ;; the sse lines a change is told on (each carries the app's shaper), a handler's notes
  ;; on its tidy-up branch, not released: a refusal is a named reason, declared on its
  ;; handler; answer-message counts every message on the app's meter; send-message! takes
  ;; :keep-alive?, an sse line :on-break
  io.github.p4ulcristian/groundwork-bridge {:git/tag "v0.7.9" :git/sha "8967097"}
  ;; the app's meter, handed in: changes heard, lines told, whether it listens
  io.github.p4ulcristian/groundwork-metrics    {:git/tag "v0.1.5" :git/sha "1cffe8e"}
  ;; the settings checked by their shapes
  metosin/malli                  {:mvn/version "0.20.3"}
  ;; Postgres's change messages read, JSON groundwork-live-updates's own trigger writes
  metosin/jsonista               {:mvn/version "1.0.2"}}

 :aliases
 {;; the JVM tests:  clojure -X:test  (the Postgres ones need LIVE_UPDATES_TEST_PORT, see README.md)
  :test {:extra-paths ["test-code"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       ;; the tests' groundwork-shaped-json, made as an app makes its own (bridge brings the same)
                       io.github.p4ulcristian/groundwork-shaped-json {:git/tag "v0.2.2" :git/sha "1c0fcf9"}
                       ;; the tests' log, made as an app makes its own (bridge brings the same)
                       io.github.p4ulcristian/groundwork-logs {:git/tag "v0.1.3" :git/sha "8d1846e"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:dirs ["test-code"]}}
  ;; the browser tests, through shadow-cljs:  npm install && npx shadow-cljs compile test
  :cljs {:extra-paths ["test-code"]
         :extra-deps  {thheller/shadow-cljs {:mvn/version "3.5.7"}}}}}
